<%= form_with(model: sponsor, local: true) do |f| %>
  <% if sponsor.errors.any? %>
    
      <%= pluralize(sponsor.errors.count, "error") %> prohibited this sponsor from being saved:
      
        <% sponsor.errors.full_messages.each do |msg| %>
          <%= msg %>
        <% end %>
      
    
  <% end %>

  
    <%= f.label :company_name, "Company Name", class: "form-label fw-bold" %>
    <%= f.text_field :company_name, class: "form-control", placeholder: "e.g., Ultra PRO", required: true %>
  

  
    
      <%= f.label :representative_name, "Representative Name", class: "form-label fw-bold" %>
      <%= f.text_field :representative_name, class: "form-control", placeholder: "Jane Doe", required: true %>
    

    
      <%= f.label :email, "Email Address", class: "form-label fw-bold" %>
      <%= f.email_field :email, class: "form-control", placeholder: "jane@example.com", required: true %>
    
  

  
    <%= f.label :message, "Message / Notes", class: "form-label fw-bold" %>
    <%= f.text_area :message, rows: 4, class: "form-control", placeholder: "Sponsorship details or notes..." %>
  
    <br>
  
    <%= f.submit 'Submit', class: "btn btn-primary btn-lg" %>
    <% if logged_in? %>
      <%= link_to "Cancel", sponsors_path, class: "btn btn-outline-secondary btn-lg" %>
    <% else %>
      <%= link_to "Cancel", expo_path, class: "btn btn-outline-secondary btn-lg" %>
    <% end %>
<% end %>