<div class='dash'>
  <div class="text-center mt-4">
    <%= image_tag('transparent_logo.png', style:'width:35%;') %>
    <br>
    <%= link_to new_sponsor_path, class: 'btn btn-primary d-inline-flex align-items-center' do %>
      <i class="bi bi-person-plus me-2"></i>ADD NEW SPONSOR
    <% end %>
    <%= link_to root_path, class: 'btn btn-dark d-inline-flex align-items-center' do %>
      <i class="bi bi-calendar-event me-2"></i>EVENTS DASHBOARD
    <% end %>
  </div>

  <h3 class="subtitle mt-4">
    <i class="bi bi-briefcase me-2 text-primary"></i>Sponsor Directory
  </h3>

  <div class="card shadow-sm border-0 overflow-hidden mb-5">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-dark">
          <tr>
            <th scope="col" class="ps-4">Company</th>
            <th scope="col">Representative</th>
            <th scope="col">Email</th>
            <th scope="col" class="text-center pe-4">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if @sponsors.any? %>
            <% @sponsors.each do |sponsor| %>
              <tr>
                <td class="ps-4">
                  <%= link_to sponsor_path(sponsor), class: 'text-decoration-none fw-semibold text-dark dashboard-link' do %>
                    <%= sponsor.company_name %> <i class="bi bi-arrow-right small text-primary opacity-0 hover-show"></i>
                  <% end %>
                </td>

                <td class="text-secondary">
                  <i class="bi bi-person me-1 small"></i>
                  <%= sponsor.representative_name %>
                </td>

                <td class="text-muted">
                  <i class="bi bi-envelope me-1 small"></i>
                  <%= mail_to sponsor.email, sponsor.email, class: "text-decoration-none text-muted" %>
                </td>

                <td class="text-center pe-4">
                  <div class="d-inline-flex gap-1">
                    <%= link_to "View", sponsor_path(sponsor), class: "btn btn-sm btn-outline-primary" %>
                    <%= link_to "Edit", edit_sponsor_path(sponsor), class: "btn btn-sm btn-outline-secondary" %>
                    <%= button_to "Delete", sponsor_path(sponsor), 
                        method: :delete, 
                        data: { turbo_confirm: "Are you sure you want to delete this sponsor?" }, 
                        form_class: "d-inline", 
                        class: "btn btn-sm btn-outline-danger" %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="text-center text-muted py-5">
                <i class="bi bi-inbox display-6 mb-2 d-block text-black-50"></i>
                No sponsors registered yet.
                <div class="mt-2">
                  <%= link_to "Add your first sponsor", new_sponsor_path, class: "btn btn-outline-primary btn-sm" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
  .dashboard-link:hover .hover-show { opacity: 1 !important; transition: opacity 0.2s ease-in-out; }
</style>