<div class="sponsor-pitch mb-5 dash">
  <!-- Header -->
  <div class="text-center mb-4">
    <span class="badge bg-danger text-uppercase px-3 py-2 mb-2 tracking-wider">Partner With Us</span>
    <h1 class="display-5 text-white title">Become a Sponsor</h1>
  </div>

  <!-- About Section -->
  <div class="card border-secondary shadow-sm mb-4 overflow-hidden">
    <div class="card-body p-4 p-md-5 text-white" style="background-color: #011 !important;">
      <h2 class="h3 subtitle text-white mb-3">Why Partner with Sip and Game?</h2>
      <p class="lead text-light mb-3">
        Sip and Game is a premier trading card show and community pop-up marketplace: bringing together passionate collectors, hobbyists, local vendors, and gaming enthusiasts.
      </p>
      <p class="text-white-50 mb-0">
        Featuring vibrant vendor marketplaces (Pokémon, One Piece, Magic: The Gathering, Riftbound, vintage collectibles, and more), open trade zones, and our signature relaxed social atmosphere, our card shows and pop-ups offer a direct connection to an active, high-intent community.
      </p>
    </div>
  </div>

  <!-- Benefits Section -->
  <div class="card border-secondary shadow-sm mb-4 overflow-hidden">
    <div class="card-body p-4 p-md-5 text-white" style="background-color: #011 !important;">
      <h2 class="h3 subtitle text-white mb-4">Sponsorship Benefits</h2>
      <div class="row g-4">
        <div class="col-md-6">
          <div class="d-flex align-items-start">
            <div class="me-3 text-danger fs-3">
              <i class="bi bi-megaphone-fill"></i>
            </div>
            <div>
              <h5 class="subtitle text-white mb-1 subtitle">High-Impact Brand Visibility</h5>
              <p class="text-white-50 mb-0">Prominent logo placement across our website, promotional flyers, social media campaigns, and on-site event signage.</p>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="d-flex align-items-start">
            <div class="me-3 text-danger fs-3">
              <i class="bi bi-people-fill"></i>
            </div>
            <div>
              <h5 class="fw-bold text-white mb-1 subtitle">Direct Community Engagement</h5>
              <p class="text-white-50 mb-0">Interact face-to-face with active collectors, hobbyists, vendors, and local creators in a welcoming environment.</p>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="d-flex align-items-start">
            <div class="me-3 text-danger fs-3">
              <i class="bi bi-shop"></i>
            </div>
            <div>
              <h5 class="fw-bold text-white mb-1 subtitle">Exclusive Activation Rights</h5>
              <p class="text-white-50 mb-0">Opportunities for branded showcase areas, product sampling, premium vendor table placement, and official event shoutouts.</p>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="d-flex align-items-start">
            <div class="me-3 text-danger fs-3">
              <i class="bi bi-sliders"></i>
            </div>
            <div>
              <h5 class="fw-bold text-white mb-1 subtitle">Tailored Packages</h5>
              <p class="text-white-50 mb-0">Flexible sponsorship opportunities designed to meet your specific community outreach, local marketing, and branding goals.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Call to Action Banner -->
  <div class="rounded border border-danger border-opacity-50 text-center text-white shadow-sm" style="background-color: #011 !important;">
    <h3 class="h4 subtitle text-white">Ready to Partner With Us?</h3>
    <p class="">
      We offer flexible sponsorship packages across our scheduled pop-ups and card shows: from local business supporters to featured showcase sponsors. Fill out the form below to connect with our team!
    </p>
  </div>
</div>
<div class='container'>
  <%= render "form", sponsor: @sponsor %>
</div>