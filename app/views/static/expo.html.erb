<div class="container my-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Event Calendar</h2>
    <%= link_to "+ New Event", new_event_path, class: "btn btn-primary" %>
  </div>

  <%= month_calendar(events: @events, attribute: :date) do |date, events| %>
    <div class="day-number mb-1 fw-bold text-muted"><%= date.day %></div>

    <% events.each do |event| %>
      <div class="event-item bg-primary text-white p-1 mb-1 rounded small">
        <%= link_to event.title, event_path(event), class: "text-white text-decoration-none fw-semibold d-block text-truncate" %>
        <% if event.location.present? %>
          <small class="d-block opacity-75 text-truncate">📍 <%= event.location %></small>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>

<style type="text/css">
	/* Calendar Layout */
.simple-calendar {
  width: 100%;
  table-layout: fixed;
  border-collapse: collapse;
  background-color: #011;
}

.simple-calendar th {
  text-align: center;
  padding: 10px;
  background-color: #FFF;
  border: 1px solid #FFF;
  text-transform: uppercase;
  font-size: 0.8rem;
  color: #6c757d;
}

.simple-calendar td {
  height: 120px;
  vertical-align: top;
  padding: 6px;
  color:#FFF;
  border: 1px solid #FFF;
  background-color: #ffffff;
}

/* Today's Date Highlight */
.simple-calendar .today {
  background-color: #eef6ff;
}

/* Days outside the current month */
.simple-calendar .prev-month,
.simple-calendar .next-month {
  background-color: #f8f9fa;
  opacity: 0.5;
}

/* Event badges */
.event-item {
  font-size: 0.8rem;
  line-height: 1.2;
}
</style>