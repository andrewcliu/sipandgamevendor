
<div class="container my-4" id='expo'>
  <div class='row'>
    <div class='col-sm-4'>
      <%= image_tag('transparent_logo.png') %>
      <p>
        Sip and Game Expo brings pop-ups and TCG events to the Bay Area and Sacramento.
      </p>
      <h5 class='subtitle'>Built for the community</h5>
      <p>
        
          <ul>
            <li>Competitive tabling rates for vendors</li>
            <li>Free entry for ALL attendees regardless of age (CA)</li>
            <li>Free parking (at home venues i.e Pacific Lighthouse & College of Alameda)</li>
            <li>
              Free limited boba as a perk if venue permits 
            </li>
          </ul>
      </p>
      <h5 class='subtitle'>Grow the community together</h5>
      <button class='btn-danger btn btn-lg disabled'>BECOME A VENDOR</button>
      <br><br>  
      <%= link_to 'BECOME A SPONSOR', "#" class: 'btn btn-danger btn-lg disabled' %>
      <br><br>
    </div>
    <div class='col-sm-8'>
      <%= image_tag('expo.jpg', class:'pop-out-img') %>
    </div>
  </div>
  <h2 class="title text-center mt-4">UPCOMING EVENTS</h2>
  <% if @events.any? %>
    <div class="row g-4 mt-2" id="events-grid">
      <% @events.each do |event| %>
        <div class="col-12 col-md-6 col-lg-4 grid-item">
          <div class="card shadow-sm">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge bg-primary text-wrap">
                  📅 <%= event.date&.strftime("%b %d, %Y") || "TBD" %>
                </span>
              </div>

              <h3 class="card-title mt-2 mb-2" style="color:white;">
                <%= event.title %>
              </h3>

              <% if event.location.present? %>
                <p class="card-text small mb-0" style="color:white;">
                  📍 <%= event.location %>
                  <hr>
                  <% if event.notes.present? %>
                    <%= event.notes.html_safe %>
                  <% else %>
                    No info yet
                  <% end %>
                </p>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-5 bg-light rounded">
      <p class="text-muted mb-3">No events found.</p>
      <%= link_to "Create your first event", new_event_path, class: "btn btn-outline-primary btn-sm" %>
    </div>
  <% end %>
</div>

<style type="text/css">
  /* Card or Image Pop-Out Effect */

/* Standalone Image Pop-Out */
.pop-out-img {
  border-radius: 12px;
  transition: transform 0.25s ease-in-out, box-shadow 0.25s ease-in-out;
}

.pop-out-img:hover {
  transform: scale(1.03);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
}
/* Container creates vertical columns instead of horizontal rows */
.events-masonry {
  column-count: 1;
  column-gap: 1.5rem;
}

/* 2 columns on tablets */
@media (min-width: 768px) {
  .events-masonry {
    column-count: 2;
  }
}

/* 3 columns on desktops */
@media (min-width: 992px) {
  .events-masonry {
    column-count: 3;
  }
}

/* Items stack snugly with consistent bottom spacing */
.events-masonry-item {
  display: inline-block;
  width: 100%;
  margin-bottom: 1.5rem;
  break-inside: avoid-column; /* Prevents cards from splitting between columns */
}
</style>