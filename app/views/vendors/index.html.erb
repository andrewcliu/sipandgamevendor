<div class="dash">
  <div class="text-center mt-4">
    <%= image_tag('transparent_logo.png', style: 'width:35%;') %>
    <br>
    <%= link_to new_vendor_path, class: 'btn btn-primary d-inline-flex align-items-center' do %>
      <i class="bi bi-person-plus me-2"></i>ADD NEW VENDOR
    <% end %>
    <%= link_to root_path, class: 'btn btn-dark d-inline-flex align-items-center' do %>
      <i class="bi bi-calendar-event me-2"></i>EVENTS DASHBOARD
    <% end %>
  </div>

  <h3 class="subtitle mt-4">
    <i class="bi bi-shop me-2 text-primary"></i>Vendor Directory & Event History
  </h3>

  <div class="card shadow-sm border-0 overflow-hidden mb-5">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-dark">
          <tr>
            <th scope="col" class="ps-4">Vendor</th>
            <th scope="col">IG Handle</th>
            <th scope="col" class="text-center">Total Shows</th>
            <th scope="col">Attended Events</th>
          </tr>
        </thead>
        <tbody>
          <% if @vendor_groups.any? %>
            <%# Sort descending by the number of attended registrations %>
            <% @vendor_groups.sort_by { |_handle, registrations| -registrations.size }.each do |handle, registrations| %>
              <% latest_vendor = registrations.first %>
              <tr>
                <td class="ps-4">
                  <span class="fw-semibold text-dark">
                    <%= latest_vendor.name&.titleize || "Unknown Vendor" %>
                  </span>
                </td>

                <td class="text-secondary">
                  <a href="https://instagram.com/<%= handle %>" target="_blank" rel="noopener" class="text-decoration-none text-muted font-monospace">
                    <i class="bi bi-instagram me-1 text-danger"></i>@<%= handle %>
                  </a>
                </td>

                <td class="text-center">
                  <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2 border border-primary-subtle fw-bold">
                    <%= registrations.size %> <%= 'Show'.pluralize(registrations.size) %>
                  </span>
                </td>

                <td class="pe-4 py-3">
                  <div class="d-flex flex-wrap gap-1">
                    <% registrations.each do |reg| %>
                      <% if reg.event %>
                        <%= link_to event_path(reg.event), class: "btn btn-sm btn-outline-secondary d-inline-flex align-items-center text-decoration-none py-1 px-2" do %>
                          <span class="small fw-semibold"><%= reg.event.title %></span>
                          <span class="badge bg-light text-muted border ms-1 font-monospace" style="font-size: 0.75rem;">
                            <%= reg.event.date.strftime("%m/%d/%y") if reg.event.date %>
                          </span>
                        <% end %>
                      <% end %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="text-center text-muted py-5">
                <i class="bi bi-shop-window display-6 mb-2 d-block text-black-50"></i>
                No vendor history found.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">